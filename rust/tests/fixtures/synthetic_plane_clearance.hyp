{VERSION=2.10}
{UNITS=METRIC LENGTH}
{PLANE_SEP=0.02}
{BOARD
(PERIMETER_SEGMENT X1=0.000 Y1=0.000 X2=3.000 Y2=0.000)
(PERIMETER_SEGMENT X1=3.000 Y1=0.000 X2=3.000 Y2=2.000)
(PERIMETER_SEGMENT X1=3.000 Y1=2.000 X2=0.000 Y2=2.000)
(PERIMETER_SEGMENT X1=0.000 Y1=2.000 X2=0.000 Y2=0.000)
(PERIMETER_SEGMENT X1=0.400 Y1=0.400 X2=0.400 Y2=0.600)
(PERIMETER_SEGMENT X1=0.400 Y1=0.600 X2=0.600 Y2=0.600)
(PERIMETER_SEGMENT X1=0.600 Y1=0.600 X2=0.600 Y2=0.400)
(PERIMETER_SEGMENT X1=0.600 Y1=0.400 X2=0.400 Y2=0.400)
(A N="board_name" V="plane test")
}
{STACKUP
(OPTIONS USE_DIE_FOR_METAL=YES)
(SIGNAL T=0.00035 P=0.0002 L=Top M=copper)
(DIELECTRIC T=0.0400 C=4.40000 LT=0.020 L=PP1 CO?=YES PR?=YES)
(PLANE T=0.00035 L=GND M=copper)
(DIELECTRIC T=0.0800 C=4.60000 LT=0.015 L=CORE PR?=NO)
(PLANE T=0.00035 L=PWR M=copper)
(DIELECTRIC T=0.0400 C=4.40000 LT=0.020 L=PP2 CO?=YES PR?=YES)
(SIGNAL T=0.00035 P=0.0002 L=Bottom M=copper)
}
{DEVICES
(R REF="R1" NAME="0603" VAL=50 L="Top")
(C REF="C1" NAME="0603" VAL=1n L="Top")
}
{SUPPLIES
(S NAME=VCC VAL=3.3 V?=YES C?=NO)
}
{PADSTACK=THRU
,0.04
(Top,1,0.08,0.08,0.0)
(GND,0,0.09,0.09,45.0)
(PWR,0,0.09,0.09,45.0)
(Bottom,2,0.08,0.08,0.0)
}
{PADSTACK=ANTI
(ADEF,1,0.12,0.12,0.0)
}
{NET=GND
(PIN X=0.200 Y=0.200 R=R1.1 P=THRU)
(SEG X1=0.600 Y1=0.200 X2=1.200 Y2=0.200 W=0.020 L=Top)
(ARC X1=1.200 Y1=0.200 X2=1.400 Y2=0.400 XC=1.200 YC=0.400 R=0.200 W=0.020 L=Top)
(VIA X=1.600 Y=0.200 P=THRU)
{POLYGON L="GND" T=PLANE W=0.010 ID=1 X=0.200 Y=1.200
  (LINE X=0.200 Y=1.800)
  (LINE X=2.800 Y=1.800)
  (LINE X=2.800 Y=1.200)
  (LINE X=0.200 Y=1.200)
}
}
{NET=PWR
(VIA X=2.400 Y=0.200 P=THRU)
{POLYGON L="PWR" T=PLANE W=0 ID=2 X=0.200 Y=0.200
  (LINE X=0.200 Y=0.800)
  (LINE X=2.800 Y=0.800)
  (LINE X=2.800 Y=0.200)
  (LINE X=0.200 Y=0.200)
}
}
{NET=TOP_NET
(SEG X1=0.800 Y1=1.500 X2=2.000 Y2=1.500 W=0.030 L=Top)
(PIN X=2.100 Y=1.500 R=C1.1 P=THRU)
}
{NET_CLASS=CLOCK
(N N=TOP_NET)
(A N="impedance" V="50")
}
{END}
{KEY=000-000-000}
